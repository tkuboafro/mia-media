---
import { SITE, NAV, MOD, type Lang } from "../config";
import { shopHome } from "../lib/shop";
interface Props { lang: Lang; title: string; description: string; ogImage?: string; alternates?: Record<string, string>; type?: string }
const { lang, title, description, ogImage, alternates = {}, type = "website" } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const canonical = new URL(Astro.url.pathname, Astro.site);
const ui = SITE.ui[lang];
const GA = import.meta.env.PUBLIC_GA4_ID;
const nav = NAV[lang];
const path = Astro.url.pathname;
const section = path.includes("/events") ? "events" : path.includes("/breweries") ? "breweries" : "news";
const consent = { en: ["We use cookieless analytics to see which stories are read. Allow analytics cookies for better statistics?", "Allow", "No thanks"], nl: ["We meten anoniem welke verhalen gelezen worden. Analytische cookies toestaan voor betere statistieken?", "Toestaan", "Nee, bedankt"], de: ["Wir messen anonym, welche Beiträge gelesen werden. Analyse-Cookies für bessere Statistiken erlauben?", "Erlauben", "Nein, danke"], es: ["Medimos de forma anónima qué historias se leen. ¿Permitir cookies analíticas para mejores estadísticas?", "Permitir", "No, gracias"], ja: ["どの記事が読まれているかを匿名で計測しています。より正確な統計のため解析クッキーを許可しますか？", "許可する", "許可しない"] }[lang];
const og = ogImage ? new URL(ogImage, Astro.site).toString() : new URL(`${base}/og-default.png`, Astro.site).toString();
---
<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title} · {SITE.name}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {Object.entries(alternates).map(([l, href]) => <link rel="alternate" hreflang={l} href={new URL(href, Astro.site)} />)}
    <meta property="og:type" content={type} />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={og} />
    <meta property="og:locale" content={{ en: "en_GB", nl: "nl_NL", de: "de_DE", es: "es_ES", ja: "ja_JP" }[lang]} />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="alternate" type="application/rss+xml" title={`${SITE.name} (${lang})`} href={`${base}/${lang}/rss.xml`} />
    <link rel="icon" href={`${base}/favicon.svg`} type="image/svg+xml" />
    {GA && <script is:inline define:vars={{ GA }}>
      window.dataLayer = window.dataLayer || []; function gtag(){ dataLayer.push(arguments); }
      // Consent Mode v2: EU 既定は拒否（クッキーなしの計測のみ）。許可でクッキー計測に切替
      gtag('consent', 'default', { analytics_storage: 'denied', ad_storage: 'denied', ad_user_data: 'denied', ad_personalization: 'denied' });
      try { if (localStorage.getItem('sw_consent') === 'granted') gtag('consent', 'update', { analytics_storage: 'granted' }); } catch (e) {}
      gtag('js', new Date()); gtag('config', GA, { anonymize_ip: true });
      var s = document.createElement('script'); s.async = true; s.src = 'https://www.googletagmanager.com/gtag/js?id=' + GA; document.head.appendChild(s);
    </script>}
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600;700&family=Noto+Serif:ital,wght@0,400;0,700;1,400&family=Noto+Serif+JP:wght@400;700&family=Noto+Sans+JP:wght@400;700&display=swap" rel="stylesheet" />
    <style is:global>
      :root { --ink:#1a1a1a; --text:#333; --muted:#666; --line:#dcdcdc; --grey:#f2f2f2; --wrap:1140px; }
      * { box-sizing: border-box; }
      html[lang=ja] { --serif: "Noto Serif JP", "Hiragino Mincho ProN", serif; --sans: "Noto Sans JP", "Hiragino Sans", sans-serif; }
      body { margin:0; font-family: var(--sans, Inter), Inter, system-ui, sans-serif; color: var(--text); background:#fff; line-height:1.6; }
      a { color: var(--ink); }
      .wrap { max-width: var(--wrap); margin: 0 auto; padding: 0 20px; }
      header.top { border-bottom:1px solid var(--line); }
      .top__in { display:grid; grid-template-columns: auto 1fr auto; align-items:center; gap:24px; min-height:72px; padding-top:10px; padding-bottom:10px; }
      .brand { text-decoration:none; display:grid; gap:2px; }
      .brand__name { font-family: var(--serif, "Noto Serif"), "Noto Serif", Georgia, serif; font-weight:700; font-size:1.35rem; letter-spacing:.01em; line-height:1; }
      .brand small { font-weight:400; color:var(--muted); font-size:.7rem; max-width:34ch; line-height:1.3; }
      .mainnav { display:flex; gap:22px; justify-content:center; font-size:.9rem; font-weight:600; }
      .mainnav a { text-decoration:none; color:var(--muted); padding:6px 0; border-bottom:2px solid transparent; }
      .mainnav a:hover, .mainnav a[aria-current] { color:var(--ink); border-bottom-color:var(--ink); }
      .top__right { display:flex; align-items:center; gap:14px; }
      nav.langs { display:flex; gap:2px; font-size:.72rem; }
      nav.langs a { text-decoration:none; color:var(--muted); padding:4px 5px; }
      nav.langs a[aria-current] { color:var(--ink); font-weight:700; border-bottom:2px solid var(--ink); }
      .shopbtn { display:grid; text-decoration:none; background:var(--ink); color:#fff; padding:8px 14px; border-radius:2px; line-height:1.2; }
      .shopbtn strong { font-size:.85rem; }
      .shopbtn small { font-size:.62rem; opacity:.8; white-space:nowrap; }
      @media (max-width: 900px) { .top__in { grid-template-columns: 1fr auto; } .mainnav { grid-column: 1 / -1; justify-content:flex-start; gap:16px; overflow-x:auto; font-size:.85rem; } .brand small { display:none; } .shopbtn small { display:none; } }
      main { padding: 32px 0 64px; }
      .narrow { max-width: 880px; }
      /* home */
      .home-hero { display:grid; grid-template-columns: 1.6fr 1fr; gap:28px; margin-bottom:36px; align-items:start; }
      .home-hero--single { grid-template-columns: 1fr; }
      .home-hero--single .lead-story { display:grid; grid-template-columns: 1.2fr 1fr; gap:24px; align-items:center; }
      .home-hero--single .lead-story .ph { grid-row: 1 / span 3; }
      @media (max-width: 800px){ .home-hero, .home-hero--single .lead-story { grid-template-columns:1fr; } .home-hero--single .lead-story .ph { grid-row:auto; } }
      .lead-story { display:grid; gap:12px; text-decoration:none; color:var(--ink); }
      .lead-story .ph { aspect-ratio:16/9; background:var(--grey); overflow:hidden; }
      .lead-story img { width:100%; height:100%; object-fit:cover; display:block; }
      .lead-story h2 { font-family: var(--serif, "Noto Serif"), "Noto Serif", Georgia, serif; font-size: clamp(1.5rem, 2.6vw, 2.2rem); line-height:1.15; margin:0; text-wrap:balance; }
      .lead-story p { margin:0; font-size:1.02rem; color:var(--text); }
      .side-stories { display:grid; gap:18px; align-content:start; }
      .side-story { display:grid; grid-template-columns: 120px 1fr; gap:12px; text-decoration:none; color:var(--ink); }
      .side-story .ph { aspect-ratio:4/3; background:var(--grey); overflow:hidden; }
      .side-story img { width:100%; height:100%; object-fit:cover; display:block; }
      .side-story h3 { font-family: var(--serif, "Noto Serif"), "Noto Serif", Georgia, serif; font-size:1.05rem; line-height:1.3; margin:0 0 4px; }
      .kicker { font-size:.72rem; color:var(--muted); display:flex; gap:10px; margin-bottom:6px; }
      .band { background:var(--grey); padding:26px 28px; display:grid; grid-template-columns: 1fr auto; gap:24px; align-items:center; margin: 8px 0 40px; }
      @media (max-width: 800px){ .band { grid-template-columns:1fr; } }
      .band h2 { font-family: Inter, sans-serif; font-size:1rem; margin:0 0 6px; letter-spacing:.02em; }
      .band p { margin:0; max-width:70ch; font-size:.95rem; }
      .band .acts { display:flex; gap:10px; flex-wrap:wrap; }
      .btn2 { display:inline-block; text-decoration:none; padding:11px 18px; border:1px solid var(--ink); color:var(--ink); font-weight:700; font-size:.85rem; border-radius:2px; background:#fff; }
      .cols { display:grid; grid-template-columns: 1fr 320px; gap:40px; align-items:start; }
      @media (max-width: 900px){ .cols { grid-template-columns:1fr; } }
      .rail { display:grid; gap:24px; position:sticky; top:16px; }
      .rail h3 { font-family: Inter, sans-serif; font-size:.9rem; margin:0 0 2px; }
      .rail .sub { font-size:.78rem; color:var(--muted); margin:0 0 10px; }
      .rail .stack { display:grid; gap:8px; }
      .sec-title { font-family: Inter, sans-serif; font-size:1rem; letter-spacing:.02em; margin:0 0 16px; padding-bottom:8px; border-bottom:2px solid var(--ink); }
      .akita { margin-top:44px; }
      .akita .tiles { display:grid; grid-template-columns: repeat(3,1fr); gap:14px; }
      @media (max-width: 700px){ .akita .tiles { grid-template-columns:1fr; } }
      .tile { position:relative; display:flex; align-items:flex-end; min-height:150px; text-decoration:none; color:#fff; background:var(--grey) center/cover no-repeat; padding:14px; }
      .tile::before { content:""; position:absolute; inset:0; background:linear-gradient(180deg, rgba(0,0,0,0) 30%, rgba(0,0,0,.65)); }
      .tile span { position:relative; font-weight:700; }
      /* article */
      .taste { border:1px solid var(--ink); padding:16px 18px; margin: 28px 0; }
      .taste h3 { font-family: Inter, sans-serif; font-size:.95rem; margin:0 0 2px; }
      .taste .sub { font-size:.8rem; color:var(--muted); margin:0 0 12px; }
      .taste .grid2 { display:grid; grid-template-columns:1fr 1fr; gap:10px; }
      @media (max-width: 700px){ .taste .grid2 { grid-template-columns:1fr; } }
      .cta2 { background:var(--ink); color:#fff; padding:26px 28px; margin-top:36px; display:grid; grid-template-columns:1fr auto; gap:20px; align-items:center; }
      @media (max-width: 700px){ .cta2 { grid-template-columns:1fr; } }
      .cta2 h3 { font-family: var(--serif, "Noto Serif"), "Noto Serif", Georgia, serif; font-size:1.4rem; margin:0 0 6px; }
      .cta2 p { margin:0; opacity:.85; font-size:.92rem; max-width:60ch; }
      .cta2 .btn { background:#fff; color:var(--ink); }
      .toc { font-size:.82rem; border-left:2px solid var(--line); padding-left:12px; }
      .toc strong { display:block; margin-bottom:6px; font-size:.78rem; letter-spacing:.04em; text-transform:uppercase; color:var(--muted); }
      .toc a { display:block; text-decoration:none; color:var(--text); padding:3px 0; }
      .share { display:flex; gap:8px; flex-wrap:wrap; font-size:.8rem; }
      .share a { text-decoration:none; border:1px solid var(--line); padding:6px 10px; color:var(--ink); }
      .related { margin-top:44px; }
      /* embeds (YouTube / press images / X / Instagram) */
      .embed { margin: 28px 0; }
      .embed--video { aspect-ratio: 16/9; background: var(--grey); }
      .embed--video iframe { width:100%; height:100%; border:0; display:block; }
      .embed--image img { width:100%; height:auto; display:block; }
      .embed figcaption { font-family: Inter, sans-serif; font-size:.78rem; color:var(--muted); margin-top:8px; line-height:1.5; }
      .embed--social { display:flex; justify-content:center; }
      .embed--social blockquote { margin:0; max-width:550px; width:100%; }
      h1 { font-family: var(--serif, "Noto Serif"), "Noto Serif", Georgia, serif; font-weight:700; line-height:1.2; letter-spacing:-.01em; font-size: clamp(1.7rem, 3.4vw, 2.5rem); margin:0 0 12px; }
      .lead { font-size:1.1rem; color:var(--text); margin:0 0 24px; }
      .meta { font-size:.8rem; color:var(--muted); display:flex; gap:12px; flex-wrap:wrap; margin-bottom:24px; }
      .badge { display:inline-block; font-size:.68rem; font-weight:700; letter-spacing:.06em; border:1px solid var(--ink); padding:2px 7px; }
      .hero { margin:0 0 28px; background:var(--grey); aspect-ratio: 16/9; overflow:hidden; }
      .hero img { width:100%; height:100%; object-fit:cover; display:block; }
      article .body { font-family: var(--serif, "Noto Serif"), "Noto Serif", Georgia, serif; font-size:1.08rem; line-height:1.85; }
      article .body h2 { font-family: Inter, sans-serif; font-size:1.15rem; margin:2em 0 .6em; }
      article .body p { margin:0 0 1.2em; }
      article .body blockquote { border-left:3px solid var(--ink); margin:1.4em 0; padding:.2em 1em; color:var(--muted); }
      .source { border-top:1px solid var(--line); margin-top:36px; padding-top:18px; font-size:.85rem; color:var(--muted); }
      .sources h2 { font-family: Inter, sans-serif; font-size:.95rem; margin:0 0 8px; }
      .sources ul { margin:0 0 10px; padding-left:1.2em; }
      .sources li { margin:0 0 4px; }
      .hero figcaption { font-size:.72rem; color:var(--muted); margin-top:6px; }
      .cta { margin-top:36px; background:var(--grey); padding:22px 24px; display:flex; justify-content:space-between; align-items:center; gap:16px; flex-wrap:wrap; }
      .btn { display:inline-block; background:#2b2b2b; color:#fff; text-decoration:none; padding:12px 22px; font-weight:700; font-size:.85rem; border-radius:2px; }
      .list { list-style:none; margin:0; padding:0; display:grid; gap:28px; }
      .card { display:grid; grid-template-columns: 1fr; gap:12px; }
      @media (min-width:640px){ .card { grid-template-columns: 220px 1fr; } }
      .card .thumb { aspect-ratio:16/9; background:var(--grey); overflow:hidden; }
      .card .thumb img { width:100%; height:100%; object-fit:cover; display:block; }
      .card h2 { font-family:"Noto Serif", Georgia, serif; font-size:1.25rem; margin:0 0 6px; line-height:1.3; }
      .card h2 a { text-decoration:none; }
      .card p { margin:0 0 6px; color:var(--text); }
      .consent[hidden] { display:none !important; }
      .consent { position:fixed; left:16px; right:16px; bottom:16px; max-width:640px; margin:0 auto; background:#fff; border:1px solid var(--line); box-shadow:0 10px 30px rgba(0,0,0,.12); padding:14px 16px; font-size:.82rem; display:flex; gap:10px; align-items:center; flex-wrap:wrap; z-index:50; }
      .consent button { font-family:Inter,sans-serif; font-size:.8rem; font-weight:700; padding:8px 14px; border:1px solid var(--ink); background:var(--ink); color:#fff; cursor:pointer; border-radius:2px; }
      .consent button.ghost { background:#fff; color:var(--ink); }
      footer.bottom { border-top:1px solid var(--line); padding:24px 0 40px; font-size:.78rem; color:var(--muted); }
      footer.bottom .wrap { display:flex; flex-wrap:wrap; gap:8px 24px; justify-content:space-between; }
    </style>
  </head>
  <body>
    <header class="top"><div class="wrap top__in">
      <a class="brand" href={`${base}/${lang}/`}><span class="brand__name">{SITE.name}</span></a>
      <nav class="mainnav" aria-label="Sections">
        <a href={`${base}/${lang}/`} aria-current={section === "news" ? "page" : undefined}>{nav.news}</a>
        <a href={`${base}/${lang}/events/`} aria-current={section === "events" ? "page" : undefined}>{nav.events}</a>
        <a href={`${base}/${lang}/breweries/`} aria-current={path.includes("/breweries") ? "page" : undefined}>{nav.breweries}</a>
        <a href={SITE.about + "?utm_source=sakewire&utm_medium=nav&utm_campaign=about"}>{nav.about}</a>
      </nav>
      <div class="top__right">
        <nav class="langs" aria-label="Language">
          {SITE.langs.map((l) => <a href={alternates[l] ?? `${base}/${l}/`} aria-current={l === lang ? "page" : undefined} hreflang={l}>{l.toUpperCase()}</a>)}
        </nav>
        <a class="shopbtn" href={shopHome({ medium: "header", campaign: "shop", content: lang })}><strong>{nav.shop} →</strong><small>{nav.shopNote}</small></a>
      </div>
    </div></header>
    <main><div class="wrap"><slot /></div></main>
    {GA && <div class="consent" id="sw-consent" hidden><span>{consent[0]}</span><button type="button" data-c="granted">{consent[1]}</button><button type="button" data-c="denied" class="ghost">{consent[2]}</button></div>}
    {GA && <script is:inline>
      (function () { var box = document.getElementById('sw-consent'); if (!box) return;
        try { if (localStorage.getItem('sw_consent')) return; } catch (e) {}
        box.hidden = false;
        box.querySelectorAll('button').forEach(function (b) { b.addEventListener('click', function () {
          var v = b.getAttribute('data-c'); try { localStorage.setItem('sw_consent', v); } catch (e) {}
          if (v === 'granted' && window.gtag) gtag('consent', 'update', { analytics_storage: 'granted' });
          box.hidden = true; }); });
      })();
    </script>}
    <footer class="bottom"><div class="wrap">
      <span>© {new Date().getFullYear()} Danshiko Lab B.V. · Amsterdam · <a href={SITE.shop}>shop.made-in-akita.com</a></span>
      <span>{ui.drink}</span>
    </div></footer>
  </body>
</html>
