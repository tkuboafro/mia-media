---
import { getCollection } from "astro:content";
import { ClientRouter } from "astro:transitions";
import "../styles/sw.css";
import Mark from "../components/Mark.astro";
import { SITE, NAV, MOD, type Lang } from "../config";
import { shopHome } from "../lib/shop";
interface Props { lang: Lang; title: string; description: string; ogImage?: string; alternates?: Record<string, string>; type?: string; ticker?: boolean }
const { lang, title, description, ogImage, alternates = {}, type = "website", ticker = true } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const canonical = new URL(Astro.url.pathname, Astro.site);
const ui = SITE.ui[lang]; const nav = NAV[lang]; const m = MOD[lang];
const GA = import.meta.env.PUBLIC_GA4_ID;
const path = Astro.url.pathname;
const section = path.includes("/events") ? "events" : path.includes("/breweries") ? "breweries" : "news";
const consent = { en: ["We use cookieless analytics to see which stories are read. Allow analytics cookies for better statistics?", "Allow", "No thanks"], nl: ["We meten anoniem welke verhalen gelezen worden. Analytische cookies toestaan voor betere statistieken?", "Toestaan", "Nee, bedankt"], de: ["Wir messen anonym, welche Beiträge gelesen werden. Analyse-Cookies für bessere Statistiken erlauben?", "Erlauben", "Nein, danke"], es: ["Medimos de forma anónima qué historias se leen. ¿Permitir cookies analíticas para mejores estadísticas?", "Permitir", "No, gracias"], ja: ["どの記事が読まれているかを匿名で計測しています。より正確な統計のため解析クッキーを許可しますか？", "許可する", "許可しない"] }[lang];
const og = ogImage ? new URL(ogImage, Astro.site).toString() : new URL(`${base}/og-default.png`, Astro.site).toString();
const wireLabel = { en: "On the wire", nl: "Op de wire", de: "Auf dem Wire", es: "En el wire", ja: "最新" }[lang];
const skip = { en: "Skip to content", nl: "Ga naar inhoud", de: "Zum Inhalt", es: "Ir al contenido", ja: "本文へ" }[lang];
const menu = { en: "Menu", nl: "Menu", de: "Menü", es: "Menú", ja: "メニュー" }[lang];
const foot = {
  en: { sections: "Sections", follow: "Follow", shop: "Shop", tagline: "Japan's sake, shochu, whisky, wine and beer — reported daily for readers in Europe.", ships: "Ships from Amsterdam to the EU", rss: "RSS feed", made: "Published in Amsterdam · Rooted in Akita" },
  nl: { sections: "Rubrieken", follow: "Volg ons", shop: "Shop", tagline: "Japanse sake, shochu, whisky, wijn en bier — dagelijks verslag voor lezers in Europa.", ships: "Verzonden uit Amsterdam naar de EU", rss: "RSS-feed", made: "Uitgegeven in Amsterdam · Geworteld in Akita" },
  de: { sections: "Rubriken", follow: "Folgen", shop: "Shop", tagline: "Japans Sake, Shochu, Whisky, Wein und Bier – täglich für Leser in Europa.", ships: "Versand aus Amsterdam in die EU", rss: "RSS-Feed", made: "Herausgegeben in Amsterdam · Verwurzelt in Akita" },
  es: { sections: "Secciones", follow: "Síguenos", shop: "Tienda", tagline: "Sake, shochu, whisky, vino y cerveza de Japón — cada día, para lectores en Europa.", ships: "Envío desde Ámsterdam a la UE", rss: "Feed RSS", made: "Publicado en Ámsterdam · Con raíces en Akita" },
  ja: { sections: "セクション", follow: "フォロー", shop: "ショップ", tagline: "日本酒・焼酎・ウイスキー・ワイン・ビール。日本のお酒の今を、毎日ヨーロッパへ。", ships: "アムステルダムから EU 全域へ発送", rss: "RSS", made: "アムステルダム発 · 秋田に根ざして" },
}[lang];
const wire = ticker ? (await getCollection("articles", (a) => a.data.lang === lang)).sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()).slice(0, 10) : [];
const fmtShort = (d: Date) => d.toLocaleDateString({ en: "en-GB", nl: "nl-NL", de: "de-DE", es: "es-ES", ja: "ja-JP" }[lang], { day: "2-digit", month: "short" });
---
<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title} · {SITE.name}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#f6f5f1" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#111316" media="(prefers-color-scheme: dark)" />
    <link rel="canonical" href={canonical} />
    {Object.entries(alternates).map(([l, href]) => <link rel="alternate" hreflang={l} href={new URL(href, Astro.site)} />)}
    <meta property="og:type" content={type} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={og} />
    <meta property="og:locale" content={{ en: "en_GB", nl: "nl_NL", de: "de_DE", es: "es_ES", ja: "ja_JP" }[lang]} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:site" content="@TheSakeWire" />
    <link rel="alternate" type="application/rss+xml" title={`${SITE.name} (${lang})`} href={`${base}/${lang}/rss.xml`} />
    <link rel="icon" href={`${base}/favicon.svg`} type="image/svg+xml" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href={`https://fonts.googleapis.com/css2?family=Instrument+Serif:ital@0;1&family=Newsreader:ital,opsz,wght@0,6..72,400;0,6..72,500;0,6..72,600;1,6..72,400&family=IBM+Plex+Mono:wght@400;500${lang === "ja" ? "&family=Noto+Serif+JP:wght@400;600&family=Noto+Sans+JP:wght@400;500;700" : ""}&display=swap`} rel="stylesheet" />
    <ClientRouter />
    {GA && <script is:inline define:vars={{ GA }}>
      window.dataLayer = window.dataLayer || []; function gtag(){ dataLayer.push(arguments); }
      gtag('consent', 'default', { analytics_storage: 'denied', ad_storage: 'denied', ad_user_data: 'denied', ad_personalization: 'denied' });
      try { if (localStorage.getItem('sw_consent') === 'granted') gtag('consent', 'update', { analytics_storage: 'granted' }); } catch (e) {}
      gtag('js', new Date()); gtag('config', GA, { anonymize_ip: true });
      var s = document.createElement('script'); s.async = true; s.src = 'https://www.googletagmanager.com/gtag/js?id=' + GA; document.head.appendChild(s);
    </script>}
  </head>
  <body>
    <a class="skip" href="#main">{skip}</a>
    <header class="top" data-open="false">
      <div class="wrap top__in">
        <a class="brand" href={`${base}/${lang}/`}><Mark class="brand__mark" /><span><span class="brand__name">{SITE.name}</span></span></a>
        <nav class="mainnav" aria-label={foot.sections}>
          <a href={`${base}/${lang}/`} aria-current={section === "news" ? "page" : undefined}>{nav.news}</a>
          <a href={`${base}/${lang}/events/`} aria-current={section === "events" ? "page" : undefined}>{nav.events}</a>
          <a href={`${base}/${lang}/breweries/`} aria-current={section === "breweries" ? "page" : undefined}>{nav.breweries}</a>
          <a href={SITE.about + "?utm_source=sakewire&utm_medium=nav&utm_campaign=about"}>{nav.about}</a>
        </nav>
        <div class="top__right">
          <nav class="langs" aria-label="Language">
            {SITE.langs.map((l) => <a href={alternates[l] ?? `${base}/${l}/`} aria-current={l === lang ? "page" : undefined} hreflang={l} lang={l} title={SITE.langNames[l]}>{l.toUpperCase()}</a>)}
          </nav>
          <a class="shopbtn" href={shopHome({ medium: "header", campaign: "shop", content: lang })}><strong>{nav.shop}</strong><small>{nav.shopNote}</small></a>
          <button class="menubtn" type="button" aria-label={menu} aria-expanded="false"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M3 7h18M3 12h18M3 17h18"/></svg></button>
        </div>
      </div>
      {ticker && wire.length > 0 && (
        <div class="ticker" aria-label={wireLabel} data-static={wire.length < 5 ? "true" : undefined}>
          <div class="wrap ticker__in">
            <span class="ticker__label"><span class="ticker__dot" aria-hidden="true"></span>{wireLabel}</span>
            <div class="ticker__track">
              <div class="ticker__list">
                {(wire.length < 5 ? wire : [...wire, ...wire]).map((a, i) => <a href={`${base}/${lang}/${a.data.story}/`} aria-hidden={i >= wire.length ? "true" : undefined} tabindex={i >= wire.length ? -1 : undefined}><b>{fmtShort(a.data.pubDate)}</b>{a.data.title}</a>)}
              </div>
            </div>
          </div>
        </div>
      )}
    </header>
    <main id="main"><div class="wrap"><slot /></div></main>
    {GA && <div class="consent" id="sw-consent" hidden><span>{consent[0]}</span><button type="button" data-c="granted">{consent[1]}</button><button type="button" data-c="denied" class="ghost">{consent[2]}</button></div>}
    <footer class="bottom">
      <div class="wrap">
        <div class="bottom__grid">
          <div class="bottom__brand">
            <a class="brand" href={`${base}/${lang}/`}><Mark class="brand__mark" /><span class="brand__name">{SITE.name}</span></a>
            <p>{foot.tagline}</p>
          </div>
          <div><h4>{foot.sections}</h4><ul>
            <li><a href={`${base}/${lang}/`}>{nav.news}</a></li>
            <li><a href={`${base}/${lang}/events/`}>{nav.events}</a></li>
            <li><a href={`${base}/${lang}/breweries/`}>{nav.breweries}</a></li>
            <li><a href={SITE.about + "?utm_source=sakewire&utm_medium=footer&utm_campaign=about"}>{nav.about}</a></li>
          </ul></div>
          <div><h4>{foot.follow}</h4><ul>
            <li><a href="https://www.instagram.com/thesakewire/" rel="me noopener" target="_blank">Instagram</a></li>
            <li><a href="https://www.threads.com/@thesakewire" rel="me noopener" target="_blank">Threads</a></li>
            <li><a href="https://x.com/TheSakeWire" rel="me noopener" target="_blank">X</a></li>
            <li><a href={`${base}/${lang}/rss.xml`}>{foot.rss}</a></li>
          </ul></div>
          <div><h4>{foot.shop}</h4><ul>
            <li><a href={shopHome({ medium: "footer", campaign: "shop", content: lang })}>shop.made-in-akita.com</a></li>
            <li>{foot.ships}</li>
            <li><a href={`${base}/${lang}/breweries/`}>{m.akitaTitle}</a></li>
          </ul></div>
        </div>
        <div class="bottom__legal">
          <span>© {new Date().getFullYear()} Danshiko Lab B.V. · {foot.made}</span>
          <span>{ui.drink}</span>
        </div>
      </div>
    </footer>
    <script is:inline>
      document.addEventListener('click', function (e) {
        var b = e.target.closest && e.target.closest('.menubtn'); if (!b) return;
        var t = b.closest('.top'); var open = t.getAttribute('data-open') === 'true';
        t.setAttribute('data-open', String(!open)); b.setAttribute('aria-expanded', String(!open));
      });
      document.addEventListener('astro:page-load', function () {
        var box = document.getElementById('sw-consent'); if (!box) return;
        try { if (localStorage.getItem('sw_consent')) return; } catch (e) {}
        box.hidden = false;
        box.querySelectorAll('button').forEach(function (btn) { btn.addEventListener('click', function () {
          var v = btn.getAttribute('data-c'); try { localStorage.setItem('sw_consent', v); } catch (e) {}
          if (v === 'granted' && window.gtag) gtag('consent', 'update', { analytics_storage: 'granted' });
          box.hidden = true; }); });
      });
    </script>
  </body>
</html>
