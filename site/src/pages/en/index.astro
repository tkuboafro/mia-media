---
import { getCollection } from "astro:content";
import Base from "../../layouts/Base.astro";
import ProductCard from "../../components/ProductCard.astro";
import Newsletter from "../../components/Newsletter.astro";
import { SITE, MOD, catLabel } from "../../config";
import { weeklyPicks, shopHome } from "../../lib/shop";
const lang = "en" as const;
const m = MOD[lang];
const articles = (await getCollection("articles", (a) => a.data.lang === lang)).sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
const [lead, ...rest] = articles;
const side = rest.slice(0, 2);
const list = rest.slice(2);
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const alternates = Object.fromEntries(SITE.langs.map((l) => [l, `${base}/${l}/`]));
const week = Math.floor(Date.now() / (7 * 864e5));
const picks = await weeklyPicks(week);
const fmt = (d: Date) => d.toLocaleDateString({ en: "en-GB", nl: "nl-NL", de: "de-DE", es: "es-ES", ja: "ja-JP" }[lang], { year: "numeric", month: "long", day: "numeric" });
const href = (a: any) => `${base}/${lang}/${a.data.story}/`;
const AKITA = [
  { name: "Kikusui (Noshiro)", img: "https://cdn.shopify.com/s/files/1/0970/5203/3348/files/mia-sake-01.jpg?width=800", href: SITE.producers + "#kks" },
  { name: "Dewatsuru / Dewanofuji", img: "https://cdn.shopify.com/s/files/1/0970/5203/3348/files/mia-sake-03.jpg?width=800", href: SITE.producers + "#sat" },
  { name: "Akita craft beer & wine", img: "https://cdn.shopify.com/s/files/1/0970/5203/3348/files/mia-beer-02.jpg?width=800", href: SITE.producers },
];
---
<Base lang={lang} title={m.latest} description={SITE.tagline[lang]} alternates={alternates}>
  {lead && (
    <section class="hero">
      <a class="lead-story" href={href(lead)}>
        <span class="ph">{lead.data.hero && <img src={lead.data.hero} alt={lead.data.heroAlt ?? ""} />}</span>
        <span class="kicker">{lead.data.category && <span>{catLabel(lead.data.category, lang)}</span>}{lead.data.regionEn && <span>{lead.data.regionEn}</span>}<span>{fmt(lead.data.pubDate)}</span></span>
        <h2>{lead.data.title}</h2>
        <p>{lead.data.description}</p>
      </a>
      <div class="side-stories">
        {side.map((a) => (
          <a class="side-story" href={href(a)}>
            <span class="ph">{a.data.hero && <img src={a.data.hero} alt="" loading="lazy" />}</span>
            <span><span class="kicker">{a.data.category && <span>{catLabel(a.data.category, lang)}</span>}<span>{fmt(a.data.pubDate)}</span></span><h3>{a.data.title}</h3></span>
          </a>
        ))}
        {side.length < 2 && <div class="side-story" aria-hidden="true"><span class="ph"></span><span><h3 style="color:var(--muted);font-weight:400">{m.eventsSoon}</h3></span></div>}
      </div>
    </section>
  )}

  <section class="band">
    <div><h2>{m.brandTitle}</h2><p>{m.brandText}</p></div>
    <div class="acts"><a class="btn" href={shopHome({ medium: "brandband", campaign: "home", content: lang })}>{m.brandShop} →</a><a class="btn2" href={SITE.about + "?utm_source=sakewire&utm_medium=brandband&utm_campaign=about"}>{m.brandAbout}</a></div>
  </section>

  <div class="cols">
    <section>
      <h2 class="sec-title">{m.latest}</h2>
      {list.length ? (
        <ul class="list">
          {list.map((a) => (
            <li class="card">
              <a class="thumb" href={href(a)} aria-hidden="true" tabindex="-1">{a.data.hero && <img src={a.data.hero} alt="" loading="lazy" />}</a>
              <div>
                <div class="kicker">{a.data.category && <span>{catLabel(a.data.category, lang)}</span>}{a.data.regionEn && <span>{a.data.regionEn}</span>}<span>{fmt(a.data.pubDate)}</span></div>
                <h2><a href={href(a)}>{a.data.title}</a></h2>
                <p>{a.data.description}</p>
              </div>
            </li>
          ))}
        </ul>
      ) : <p style="color:var(--muted)">{m.eventsSoon}</p>}
    </section>
    <aside class="rail">
      <div><h3>{m.weekly}</h3><p class="sub">{m.weeklySub}</p><div class="stack">{picks.map((p) => <ProductCard p={p} lang={lang} utm={{ medium: "rail", campaign: "home", content: lang }} compact />)}</div></div>
      <Newsletter lang={lang} />
    </aside>
  </div>

  <section class="akita">
    <h2 class="sec-title">{m.akitaTitle} <span style="font-weight:400;color:var(--muted);font-size:.85rem;margin-left:8px">{m.akitaText}</span></h2>
    <div class="tiles">{AKITA.map((t) => <a class="tile" href={t.href + (t.href.includes("?") ? "&" : "?") + "utm_source=sakewire&utm_medium=akita&utm_campaign=home"} style={`background-image:url(${t.img})`}><span>{t.name}</span></a>)}</div>
  </section>
</Base>
