---
import { getCollection } from "astro:content";
import Article from "../../components/Article.astro";
export async function getStaticPaths() {
  const all = await getCollection("articles", (a) => a.data.lang === "de");
  return all.map((a) => ({ params: { slug: a.data.story }, props: { a } }));
}
const { a } = Astro.props;
---
<Article a={a} lang="de" />
