---
// 言語を選ばせるより、ブラウザ言語で振り分ける（既定 en）。
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
---
<!doctype html><html><head><meta charset="utf-8" /><title>The Sake Wire</title>
<!-- 2026-11-21 GSC「重複: Google が別の正規ページを選択」（/en/）: このページは言語の振り分けだけ。正規は /en/ と明示し、サイトマップからも外す -->
<link rel="canonical" href="https://sakewire.com/en/" />
{["en", "nl", "de", "es", "ja"].map((l) => <link rel="alternate" hreflang={l} href={`https://sakewire.com/${l}/`} />)}
<link rel="alternate" hreflang="x-default" href="https://sakewire.com/en/" />
<meta http-equiv="refresh" content={`1; url=${base}/en/`} />
<script is:inline define:vars={{ base }}>
  const l = (navigator.language || "en").slice(0, 2);
  location.replace(base + "/" + (["nl", "de", "es", "ja"].includes(l) ? l : "en") + "/");
</script></head><body><a href={`${base}/en/`}>English</a></body></html>
