---
// 言語を選ばせるより、ブラウザ言語で振り分ける（既定 en）。
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
---
<!doctype html><html><head><meta charset="utf-8" /><title>MADE IN AKITA Journal</title>
<meta http-equiv="refresh" content={`1; url=${base}/en/`} />
<script is:inline define:vars={{ base }}>
  const l = (navigator.language || "en").slice(0, 2);
  location.replace(base + "/" + (["nl", "de", "es"].includes(l) ? l : "en") + "/");
</script></head><body><a href={`${base}/en/`}>English</a></body></html>
