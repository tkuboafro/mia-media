---
import { MOD, type Lang } from "../config";
const { lang } = Astro.props as { lang: Lang };
const m = MOD[lang];
---
<form class="nl" method="post" action="https://shop.made-in-akita.com/contact#contact_form" accept-charset="UTF-8" target="_blank">
  <input type="hidden" name="form_type" value="customer" /><input type="hidden" name="utf8" value="✓" />
  <input type="hidden" name="contact[tags]" value={`newsletter,sakewire,${lang}`} />
  <input type="hidden" name="contact[accepts_marketing]" value="true" />
  <strong>{m.newsTitle}</strong>
  <p>{m.newsText}</p>
  <div class="nl__row"><label class="vh" for={`nl-${lang}`}>Email</label><input id={`nl-${lang}`} type="email" name="contact[email]" placeholder={m.newsPh} required /><button type="submit">{m.newsBtn}</button></div>
</form>
