---
import Base from "../layouts/Base.astro";
import Newsletter from "./Newsletter.astro";
import { SITE, NAV, MOD, type Lang } from "../config";
import producers from "../data/producers.json";
const { lang } = Astro.props as { lang: Lang };
const nav = NAV[lang]; const m = MOD[lang];
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const alternates = Object.fromEntries(SITE.langs.map((l) => [l, `${base}/${l}/breweries/`]));
const intro = { en: "The eleven producers behind MADE IN AKITA's bottles — small sake breweries, micro-wineries and a craft brewery in Akita, northern Japan.", nl: "De elf producenten achter de flessen van MADE IN AKITA — kleine sakebrouwerijen, microwijnhuizen en een craftbrouwerij in Akita, Noord-Japan.", de: "Die elf Produzenten hinter den Flaschen von MADE IN AKITA – kleine Sake-Brauereien, Mikro-Weingüter und eine Craft-Brauerei in Akita, Nordjapan.", es: "Los once productores detrás de las botellas de MADE IN AKITA: pequeñas bodegas de sake, microbodegas de vino y una cervecería artesanal en Akita, al norte de Japón.", ja: "MADE IN AKITA のボトルを醸す11の造り手。秋田の小さな酒蔵、マイクロワイナリー、クラフトブルワリー。" }[lang];
const shopLabel = { en: "Bottles from this producer", nl: "Flessen van deze producent", de: "Flaschen dieses Produzenten", es: "Botellas de este productor", ja: "この蔵のボトルを見る" }[lang];
const since = { en: "since", nl: "sinds", de: "seit", es: "desde", ja: "創業" }[lang];
---
<Base lang={lang} title={nav.breweries} description={intro} alternates={alternates}>
  <header class="reveal"><span class="mono">Akita · Japan</span><h1 class="page-title">{nav.breweries}</h1><p class="page-lead">{intro}</p></header>
  <div class="plist">
    {producers.map((p, i) => (
      <article class="pcardx" id={p.code}>
        <span class="pcardx__n" aria-hidden="true">{String(i + 1).padStart(2, "0")}</span>
        <div class="pcardx__body">
          <div class="dateline"><span class="cat">{p.category}</span><span>{p.place}</span><span>{since} {p.founded}</span></div>
          <h2>{lang === "ja" ? p.name_ja : p.name}<small>{lang === "ja" ? p.name : p.name_ja}</small></h2>
          <p class="brandname">{p.brand}</p>
          <p>{lang === "ja" ? p.description_ja : p.description}</p>
          <a class="btn btn--ink" href={p.collection + "?utm_source=sakewire&utm_medium=breweries&utm_campaign=" + p.code}>{shopLabel} →</a>
        </div>
        <a class="pcardx__img" href={p.collection + "?utm_source=sakewire&utm_medium=breweries&utm_campaign=" + p.code} tabindex="-1" aria-hidden="true"><img src={p.image} alt="" loading="lazy" /></a>
      </article>
    ))}
  </div>
  <div style="max-width:520px;margin-top:clamp(32px,5vw,56px)"><Newsletter lang={lang} /></div>
</Base>
