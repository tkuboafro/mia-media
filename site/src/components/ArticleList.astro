---
import { SITE, type Lang } from "../config";
const { articles, lang } = Astro.props as { articles: any[]; lang: Lang };
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const ui = SITE.ui[lang];
const fmt = (d: Date) => d.toLocaleDateString({ en: "en-GB", nl: "nl-NL", de: "de-DE", es: "es-ES" }[lang], { year: "numeric", month: "long", day: "numeric" });
---
<ul class="list">
  {articles.map((a) => (
    <li class="card">
      <a class="thumb" href={`${base}/${lang}/${a.data.slug}/`} aria-hidden="true" tabindex="-1">{a.data.hero && <img src={a.data.hero} alt="" loading="lazy" />}</a>
      <div>
        <div class="meta" style="margin-bottom:6px">{a.data.akita && <span class="badge">{ui.akita}</span>}<span>{fmt(a.data.pubDate)}</span>{a.data.region && <span>{a.data.region}</span>}</div>
        <h2><a href={`${base}/${lang}/${a.data.slug}/`}>{a.data.title}</a></h2>
        <p>{a.data.description}</p>
        <a href={`${base}/${lang}/${a.data.slug}/`}>{ui.readMore} →</a>
      </div>
    </li>
  ))}
</ul>
