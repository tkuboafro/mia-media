---
import { MOD, type Lang } from "../config";
import { shopUrl, type Product } from "../lib/shop";
const { p, lang, utm, compact = false } = Astro.props as { p: Product; lang: Lang; utm: { medium: string; campaign: string; content?: string }; compact?: boolean };
const m = MOD[lang];
const eur = (v: number) => (lang === "en" ? `€${v.toFixed(2)}` : `€${v.toFixed(2).replace(".", ",")}`);
---
<a class={`pcard${compact ? " pcard--compact" : ""}`} href={shopUrl(p.handle, utm)} target="_blank" rel="noopener">
  <span class="pcard__img">{p.image && <img src={p.image} alt="" loading="lazy" />}</span>
  <span class="pcard__body">
    <span class="pcard__title">{p.title}</span>
    <span class="pcard__meta">{p.type}{p.tags.includes("Trial") ? " · 180 ml" : ""}</span>
    <span class="pcard__price">{eur(p.price)} <small>· {m.order} — {m.ships}</small></span>
  </span>
</a>
